{
  "compilerOptions": {
    "target": "es2020",
    "types": ["vite/client"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
